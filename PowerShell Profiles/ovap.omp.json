{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"palette": {
		"blue": "#0079be",
		"dark_blue": "#191f48",
		"dark_blue2": "#025779",
		"orange": "#ec8848",
		"purple": "#8c4ffd",
		"red": "#CC3802",
		"sky": "#86BBD8",
		"teal": "#047E84",
		"white": "#FFFFFF"
	},
	"console_title_template": "{{.UserName}}{{if .Root}} :: root{{end}} :: {{.Shell}} :: {{.PWD}}",
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"cache": {
						"duration": "none"
					},
					"leading_diamond": "\ue0b6",
					"template": "{{if .Root}} \uf09c {{end}}{{if .SSHSession}}\ueba9 {{end}}{{ .UserName }} ",
					"foreground": "p:white",
					"background": "p:blue",
					"type": "session",
					"style": "diamond"
				},
				{
					"options": {
						"style": "folder"
					},
					"cache": {
						"duration": "none"
					},
					"template": " {{ .Path }} ",
					"foreground": "p:white",
					"powerline_symbol": "\ue0b0",
					"background": "p:dark_blue2",
					"type": "path",
					"style": "powerline"
				},
				{
					"options": {
						"branch_icon": "",
						"fetch_status": false,
						"fetch_upstream_icon": true
					},
					"cache": {
						"duration": "none"
					},
					"template": " {{ .UpstreamIcon }}  {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
					"foreground": "p:white",
					"powerline_symbol": "\ue0b0",
					"background": "p:purple",
					"type": "git",
					"style": "powerline"
				},
				{
					"options": {
						"cache_duration": "none"
					},
					"template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
					"foreground": "p:white",
					"powerline_symbol": "\ue0b0",
					"background": "p:sky",
					"type": "node",
					"style": "powerline"
				},
				{
					"cache": {
						"duration": "none"
					},
					"template": " \ue235 {{ .Venv }} ",
					"foreground": "p:white",
					"powerline_symbol": "\ue0b0",
					"background": "p:sky",
					"type": "python",
					"style": "powerline"
				},
				{
					"cache": {
						"duration": "none"
					},
					"template": " \udb83\ude0f {{.Profile}}{{if .Region}}@{{.Region}}{{end}} ",
					"foreground": "p:white",
					"powerline_symbol": "\ue0b0",
					"background": "p:sky",
					"type": "aws",
					"style": "powerline"
				},
				{
					"cache": {
						"duration": "none"
					},
					"template": " \uebd8 {{ .EnvironmentName }} ",
					"foreground": "p:white",
					"powerline_symbol": "\ue0b0",
					"background": "p:sky",
					"type": "az",
					"style": "powerline"
				},
				{
					"cache": {
						"duration": "none"
					},
					"trailing_diamond": "\ue0b0",
					"template": " \uf0f4  {{ .CurrentDate | date .Format }} ",
					"foreground": "p:orange",
					"background": "p:dark_blue",
					"options": {
						"time_format": "3:04PM"
					},
					"type": "time",
					"style": "diamond"
				}
			]
		}
	],
	"version": 3,
	"final_space": true
}
